{
  "name": "rekrutai",
  "version": "2.0.0",
  "description": "Rekrut AI - The candidate credit score platform with OmniScore",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "build": "cd client && npm install --include=dev && npm run build",
    "test": "npx playwright test",
    "test:e2e": "./run-e2e-full-suite.sh",
    "test:e2e:headed": "./run-e2e-full-suite.sh --headed",
    "test:e2e:debug": "./run-e2e-full-suite.sh --debug",
    "test:e2e:perfile": "./run-e2e-perfile.sh",
    "migrate": "node migrate.js",
    "lint": "npx @biomejs/biome check",
    "postinstall": "bash scripts/setup-audio.sh 2>&1 || echo '[postinstall] Audio setup skipped (non-fatal)'"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.30.0",
    "bcryptjs": "^2.4.3",
    "connect-pg-simple": "^10.0.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^17.3.1",
    "express": "^4.18.2",
    "express-session": "^1.17.3",
    "express-validator": "^7.3.2",
    "form-data": "^4.0.0",
    "googleapis": "^173.0.0",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.6.0",
    "multer": "^1.4.5-lts.1",
    "node-fetch": "^2.7.0",
    "nodemailer": "^8.0.10",
    "openai": "^4.20.1",
    "pdf-parse": "^1.1.1",
    "pg": "^8.11.3",
    "pgvector": "^0.1.5",
    "simple-oauth2": "^4.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@playwright/test": "^1.60.0",
    "jest": "^30.4.2",
    "supertest": "^7.2.2"
  }
}
