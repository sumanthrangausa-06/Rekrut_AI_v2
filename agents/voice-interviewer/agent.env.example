# Secrets for the voice interviewer agent (LiveKit Cloud).
#
# Copy to agent.env (gitignored — NEVER commit values) and pass to the CLI:
#   lk agent create --secrets-file agents/voice-interviewer/agent.env .
#
# Do NOT put LIVEKIT_URL / LIVEKIT_API_KEY / LIVEKIT_API_SECRET here —
# LiveKit Cloud injects those itself.
#
# Values come from the same sources as the backend (staging: Render env vars).

# Optional: override the registered agent name. MUST match what Task 2's
# dispatch targets (server/services/livekit.js getVoiceAgentName()).
# Default when unset: rekrut-interviewer
LIVEKIT_AGENT_NAME=rekrut-interviewer

# Postgres the backend uses (session load/save). Same value as DATABASE_URL.
DATABASE_URL=

# Cartesia TTS (the worker requests raw PCM for LiveKit publishing).
CARTESIA_API_KEY=

# LLM/STT provider keys, same JSON the backend reads.
AI_KEYS_JSON=
