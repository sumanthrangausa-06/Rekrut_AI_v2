# Rekrut AI - Environment Configuration Template
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to git

# Database (Neon)
# For local development, use your local PostgreSQL instance:
# DATABASE_URL=postgresql://test:test@localhost:5432/rekrutai
# SECURITY: The production Neon endpoint is blocked in non-production environments.
#           The server will refuse to start if DATABASE_URL contains the prod host.
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Security Secrets (Required — generate strong random strings)
# Use: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=YOUR_STRONG_SESSION_SECRET_HERE
JWT_SECRET=YOUR_STRONG_JWT_SECRET_HERE

# Encryption Key for Identity Verification (AES-256-GCM)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=YOUR_64_HEX_CHAR_ENCRYPTION_KEY_HERE

# Admin Credentials (Required — the admin panel will refuse to start without these)
# Admin password MUST be at least 8 characters with uppercase, lowercase, number, and symbol.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Changeme123!

# Server
PORT=3000
NODE_ENV=development

# ClickHouse Analytics (Optional — Issue #143)
# Set to enable ClickHouse analytics store alongside PostgreSQL
# CLICKHOUSE_URL=http://localhost:8123/default
# USE_CLICKHOUSE_ANALYTICS=false
# ANALYTICS_SYNC_BATCH_SIZE=500
# ANALYTICS_SYNC_INTERVAL_MS=300000

# AI Providers (to be filled by user)
POLSIA_API_KEY=your-polsia-api-key
POLSIA_API_URL=https://polsia.com/api/proxy/ai
OPENAI_API_KEY=your-openai-api-key
NVIDIA_NIM_API_KEY=your-nvidia-nim-api-key
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
GROQ_API_KEY=your-groq-api-key
CEREBRAS_API_KEY=your-cerebras-api-key
DEEPGRAM_API_KEY=your-deepgram-api-key

# Cartesia TTS
CARTESIA_API_KEY=your-cartesia-api-key
CARTESIA_DEFAULT_VOICE_ID=f9fc912e-52f0-448a-8bfa-47e9ca75f25a

# Email (Brevo HTTP API preferred — bypasses Render SMTP block)
BREVO_API_KEY=your-brevo-api-key

# Email (SMTP fallback)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your-brevo-smtp-user
SMTP_PASS=your-brevo-smtp-pass

# Stripe (Production)
STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key
STRIPE_SECRET_KEY=sk_test_your_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_RESTRICTED_KEY=rk_live_your_restricted_key

# Google OAuth (Login / Sign-up)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Must match exactly what's registered in Google Cloud Console > Credentials > Authorized redirect URIs
# Local dev:  http://localhost:3000/api/auth/google/callback
# Staging:    https://rekrutai-staging.onrender.com/api/auth/google/callback
# Production: https://rekrut.ai/api/auth/google/callback
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# LinkedIn OAuth (Login / Sign-up)
LINKEDIN_CLIENT_ID=your-linkedin-client-id
LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret
# Must match exactly what's registered in LinkedIn Developer Portal > Auth > OAuth 2.0 > Authorized redirect URLs
# Local dev:  http://localhost:3000/api/auth/linkedin/callback
# Staging:    https://rekrutai-staging.onrender.com/api/auth/linkedin/callback
# Production: https://rekrut.ai/api/auth/linkedin/callback
LINKEDIN_REDIRECT_URI=http://localhost:3000/api/auth/linkedin/callback

# Calendar Integration — Google Calendar
GOOGLE_CALENDAR_REDIRECT_URI=https://rekrut.ai/api/calendar/oauth/callback

# Calendar Integration — Microsoft Outlook
OUTLOOK_CLIENT_ID=your-outlook-client-id
OUTLOOK_CLIENT_SECRET=your-outlook-client-secret
OUTLOOK_REDIRECT_URI=https://rekrut.ai/api/calendar/oauth/callback
