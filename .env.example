# Rekrut AI - Environment Configuration Template
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to git

# Database (Neon)
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Security Secrets (Required)
SESSION_SECRET=change-me-in-production-strong-random-string
JWT_SECRET=change-me-in-production-strong-random-string

# Admin Credentials (Required for admin panel access)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-strong-password

# Server
PORT=3000
NODE_ENV=development

# AI Providers (to be filled by user)
POLSIA_API_KEY=your-polsia-api-key
POLSIA_API_URL=https://polsia.com/api/proxy/ai
OPENAI_API_KEY=your-openai-api-key
NVIDIA_NIM_API_KEY=your-nvidia-nim-api-key
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
GROQ_API_KEY=your-groq-api-key
CEREBRAS_API_KEY=your-cerebras-api-key
DEEPGRAM_API_KEY=your-deepgram-api-key

# Email (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password

# Stripe (Test Mode)
STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key
STRIPE_SECRET_KEY=sk_test_your_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
